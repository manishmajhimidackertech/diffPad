   <text:p text:style-name="Heading_20_1"><text:span text:style-name="T3">Q2 2026 Marketing Performance Report</text:span></text:p>
   <text:p text:style-name="Standard">This report reviews marketing performance for the second quarter of 2026. Overall, the Marketing Team exceeded its lead-generation targets while keeping spend within budget.</text:p>
   <text:p text:style-name="Standard">A revised methodology was applied this quarter to better attribute leads across channels.</text:p>
   <text:p text:style-name="Heading_20_2">Key Metrics</text:p>
   <table:table table:name="Table1" table:style-name="Table1">
    <table:table-column table:style-name="Table1.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row table:style-name="Table1.1">
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Standard"><text:span text:style-name="T4">Metric</text:span></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Standard"><text:span text:style-name="T4">Q1 2026</text:span></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Standard"><text:span text:style-name="T4">Q2 2026</text:span></text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A2" office:value-type="string">
      <text:p text:style-name="Standard">Leads Generated</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B2" office:value-type="string">
      <text:p text:style-name="Standard">1,240</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.C2" office:value-type="string">
      <text:p text:style-name="Standard">1,610</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A3" office:value-type="string">
      <text:p text:style-name="Standard">Conversion Rate</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B3" office:value-type="string">
      <text:p text:style-name="Standard">3.1%</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.C3" office:value-type="string">
      <text:p text:style-name="Standard"><text:span text:style-name="T5">3.4%</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A4" office:value-type="string">
      <text:p text:style-name="Standard">Ad Spend</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B4" office:value-type="string">
      <text:p text:style-name="Standard">$82,000</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.C4" office:value-type="string">
      <text:p text:style-name="Standard">$79,500</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table1.1">
     <table:table-cell table:style-name="Table1.A5" office:value-type="string">
      <text:p text:style-name="Standard">Email Open Rate</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.B5" office:value-type="string">
      <text:p text:style-name="Standard">22%</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.C5" office:value-type="string">
      <text:p text:style-name="Standard">27%</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Heading_20_2">Highlights</text:p>
   <text:list text:style-name="WWNum2">
    <text:list-item text:start-value="1">
     <text:p text:style-name="P4">Redesigned the landing page, improving load time by 40%.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P4">Launched the spring email <text:s/>campaign, reaching 45,000 subscribers.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P4">Expanded paid social presence into three new regions.</text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P4">Southeast Asia pilot</text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P4">Latin America pilot</text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P4">Eastern Europe pilot</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P4"><text:change-start text:change-id="ct94467196683232"/>Piloted an AI-assisted copywriting tool for ad variants.<text:change-end text:change-id="ct94467196683232"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P4"><text:change-start text:change-id="ct94467198544704"/>Onboarded a new analytics vendor for attribution tracking.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard"><text:change-end text:change-id="ct94467198544704"/></text:p>
   <text:p text:style-name="Heading_20_2">Team Notes</text:p>
   <text:p text:style-name="Standard">The full dashboard is available on our <text:a xlink:type="simple" xlink:href="https://analytics.example.com/dashboard/v2" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">internal analytics portal</text:span></text:a>, updated nightly.</text:p>
   <text:p text:style-name="Standard">The dashboard also now includes a <text:a xlink:type="simple" xlink:href="https://analytics.example.com/dashboard/v2" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">forecasting module</text:span></text:a> for Q3 planning.</text:p>
   <text:p text:style-name="Standard">Special thanks to the design team for their support this quarter<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body>
      <text:p text:style-name="Standard">Particularly Maria Chen, Devon Ruiz, and the brand team for the new templates.</text:p></text:note-body></text:note>.</text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/>Their contributions were instrumental in the landing page redesign.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P3">Looking Ahead</text:p>
   <text:p text:style-name="Standard"><office:annotation office:name="__Annotation__164_115379115" loext:resolved="false">
     <dc:creator>Claude</dc:creator>
     <dc:date>2026-08-03T12:12:30</dc:date>
     <meta:creator-initials>C</meta:creator-initials>
     <text:p><text:span text:style-name="T8">Can we get a firmer date for the AI copywriting pilot rollout?</text:span></text:p>
    </office:annotation>Q3 priorities include expanding the forecasting dashboard and scaling the AI copywriting pilot.<office:annotation-end office:name="__Annotation__164_115379115"/></text:p>
  </office:text>
 </office:body>
</office:document>